# ESP32-C3_SUPERMINI_TH
#
DEF ESP32-C3_SUPERMINI_TH U 0 40 Y Y 1 L N
F0 "U" -500 630 50 H V L BNN
F1 "ESP32-C3_SUPERMINI_TH" -500 -800 50 H V L BNN
F2 "MODULE_ESP32-C3_SUPERMINI_TH" 0 0 50 H I L BNN
F3 "" 0 0 50 H I L BNN
F4 "" 0 0 50 H I L BNN "VERIFIER"
F5 "Espressif Systems" 0 0 50 H I L BNN "MANUFACTURER"
F6 "IPC-7351B" 0 0 50 H I L BNN "STANDARD"
F7 "DIZAR" 0 0 50 H I L BNN "CREATOR"
DRAW
S -500 -700 500 600 0 0 10 f
X 5V 5V 700 500 200 L 40 40 0 0 W 
X GND G 700 -600 200 L 40 40 0 0 W 
X 3V3 3.3 700 400 200 L 40 40 0 0 W 
X GPIO0 0 -700 200 200 R 40 40 0 0 B 
X GPIO1 1 -700 100 200 R 40 40 0 0 B 
X GPIO2 2 -700 0 200 R 40 40 0 0 B 
X GPIO3 3 -700 -100 200 R 40 40 0 0 B 
X GPIO4 4 -700 -200 200 R 40 40 0 0 B 
X GPIO5 5 -700 -300 200 R 40 40 0 0 B 
X GPIO6 6 -700 -400 200 R 40 40 0 0 B 
X GPIO7 7 700 200 200 L 40 40 0 0 B 
X GPIO8 8 700 100 200 L 40 40 0 0 B 
X GPIO9 9 700 0 200 L 40 40 0 0 B 
X GPIO10 10 700 -100 200 L 40 40 0 0 B 
X GPIO20 20 700 -200 200 L 40 40 0 0 B 
X GPIO21 21 700 -300 200 L 40 40 0 0 B 
ENDDRAW
ENDDEF
